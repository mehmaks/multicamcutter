# Logs
logs/
*.log

# Python
__pycache__/
*.pyc
*.pyo
.Python
venv/
.venv/
*.egg-info/

# Media files (too large for git)
*.mp4
*.mov
*.mxf
*.avi
*.mkv
*.wav
*.mp3
*.aac

# Output files (generated, not source)
*.edl
*.html
*.csv

# Benutzerspezifische Projekt-Settings (pro Rechner verschieden)
config/project_settings/

# Config mit persönlichen Tokens — Template liegt im Repo, nicht die echte config.ini
config/config.ini

# Streamlit-Config (wird beim Start aus config.template.toml erzeugt)
.streamlit/config.toml

# Sandbox-Tools (lokale Entwicklung, nicht versioniert)
tools/

# macOS
.DS_Store
.AppleDouble

# IDE
.vscode/
.idea/
*.swp

# Lizenz-System (komplett lokal, nie ins Repo)
licensing/

# UI-Fonts (werden via setup.sh geladen, nicht versioniert)
ui/static/*.ttf
