# Logs
logs/
*.log

# Python
__pycache__/
*.pyc
*.pyo
.Python
venv/
.venv/
*.egg-info/

# Media files (too large for git)
*.mp4
*.mov
*.mxf
*.avi
*.mkv
*.wav
*.mp3
*.aac

# Output files (generated, not source)
*.edl
*.html
*.csv

# Benutzerspezifische Projekt-Settings (pro Rechner verschieden)
config/project_settings/

# Config mit persönlichen Tokens — Template liegt im Repo, nicht die echte config.ini
config/config.ini

# Streamlit-Config (wird beim Start aus config.template.toml erzeugt)
.streamlit/config.toml

# Sandbox-Tools (lokale Entwicklung, nicht versioniert)
tools/
**/sandbox/

# macOS
.DS_Store
.AppleDouble

# IDE
.vscode/
.idea/
*.swp

# Lizenz-System — Private Key und generierte Lizenzen nie ins Repo
licensing/license_private.key
licensing/licenses/

# UI-Fonts (werden via setup.sh geladen, nicht versioniert)
ui/static/*.ttf

# venv-Backups (lokale Python-Umgebungen)
venv_py39_backup/

# MediaPipe-Modell (wird per _ensure_model() bei Bedarf heruntergeladen)
modules/multicam_cutter/face_landmarker.task

# Auto-Memory von Claude Code (Session-spezifisch, gehört nicht ins Repo)
memory/

# Lokale Brain-Files für Claude Code (Kontext-Hints pro Ordner, nicht versioniert)
CLAUDE.md

# Statische ffmpeg/ffprobe (arm64, osxexperts.net) — Build-Input, nicht versionieren
apps/multicam-cutter/scripts/ffmpeg
apps/multicam-cutter/scripts/ffprobe

# MultiCamCutter Build-Artefakte (generiert — mehrere GB, nie versionieren)
apps/multicam-cutter/dist/
apps/multicam-cutter/build/
apps/multicam-cutter/release/
**/.build/
**/.swiftpm/
*.dmg

# wrangler-Cache (enthaelt Account-Daten)
.wrangler/
!analyse/player/player.html
