/* Beta-Kanal (Einstellungen → Updates) */
"Receive beta versions" = "Beta-Versionen erhalten";
"Beta versions bring new features before the official release. They are tested, but may still contain errors. You can switch back at any time." = "Beta-Versionen bringen neue Funktionen vor dem offiziellen Release. Sie sind getestet, können aber noch Fehler enthalten. Du kannst jederzeit zurückwechseln.";
"Return to the stable version?" = "Zur stabilen Version zurückkehren?";
